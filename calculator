def main():
    """Display the main menu."""
    while True:
        print("\n===== INTERACTIVE CALCULATOR =====")
        print("1. Basic Calculator")
        print("2. Unit Converter")
        print("3. Currency Converter")
        print("4. Exit")

        choice = input("Enter your choice (1-4): ").strip()

        if choice == "1":
